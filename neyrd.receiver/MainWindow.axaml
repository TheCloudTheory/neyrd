<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="neyrd.receiver.MainWindow"
        Title="neyrd.receiver">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#1e1e1e" Padding="8,4">
            <TextBlock x:Name="StatusBar" Foreground="#aaaaaa" FontSize="12" />
        </Border>
        <Grid>
            <TextBlock x:Name="Placeholder" Text="Waiting for the emitter..."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="16" />
            <Image x:Name="ScreenImage" Stretch="Uniform" />
        </Grid>
    </DockPanel>
</Window>