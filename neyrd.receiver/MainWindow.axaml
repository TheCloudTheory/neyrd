<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="neyrd.receiver.MainWindow"
        Title="Neyrd"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerWheelChanged="OnPointerWheelChanged"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp"
        Icon="avares://neyrd.receiver/Assets/neyrd.ico">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#1e1e1e" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="IpLabel" Foreground="#aaaaaa" FontSize="12" />
                <TextBlock x:Name="LatencyLabel" Foreground="#aaaaaa" FontSize="12" />
                <TextBlock x:Name="VersionLabel" Foreground="#aaaaaa" FontSize="12" />
            </StackPanel>
        </Border>
        <Grid>
            <TextBlock x:Name="Placeholder" Text="Waiting for the emitter..."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="16" />
            <Image x:Name="ScreenImage" Stretch="Uniform" />
        </Grid>
    </DockPanel>
</Window>